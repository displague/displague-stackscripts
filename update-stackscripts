#!/usr/bin/env python3
"""Update or view Linode StackScripts from local repository directories."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


ROOT_DIR = Path(__file__).resolve().parent


def run_linode_cli(args):
    cmd = ["linode-cli", "--json"] + args
    res = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if res.returncode != 0:
        sys.stderr.write(res.stderr)
        sys.exit(res.returncode)
    return json.loads(res.stdout)


def parse_stackscript_dir(ss_dir: Path):
    script_path = ss_dir / "stackscript.sh"
    if not script_path.exists():
        raise FileNotFoundError(f"Missing {script_path}")

    script = script_path.read_text(encoding="utf-8")
    readme_path = ss_dir / "README.md"
    description = readme_path.read_text(encoding="utf-8") if readme_path.exists() else ""

    images_path = ss_dir / "images.txt"
    images = []
    if images_path.exists():
        images = [
            line.strip()
            for line in images_path.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.strip().startswith("#")
        ]

    return {
        "script": script,
        "description": description,
        "images": images,
    }


def cmd_summary(_args):
    dirs = sorted(
        p for p in ROOT_DIR.iterdir()
        if p.is_dir() and p.name.isdigit() and (p / "stackscript.sh").exists()
    )
    for d in dirs:
        info = parse_stackscript_dir(d)
        print(f"StackScript {d.name}: {len(info['images'])} configured images")


def cmd_update(args):
    targets = args.ids if args.ids else [
        p.name for p in sorted(ROOT_DIR.iterdir())
        if p.is_dir() and p.name.isdigit() and (p / "stackscript.sh").exists()
    ]
    for ssid in targets:
        ss_dir = ROOT_DIR / str(ssid)
        info = parse_stackscript_dir(ss_dir)
        cli_args = [
            "stackscripts", "update", str(ssid),
            "--script", info["script"],
        ]
        if args.rev_note:
            cli_args += ["--rev_note", args.rev_note]
        for img in info["images"]:
            cli_args += ["--images", img]

        updated = run_linode_cli(cli_args)
        entry = updated[0] if updated else {}
        print(
            f"Updated StackScript {ssid} ({entry.get('label', '')}): "
            f"{len(entry.get('images', []))} images, updated={entry.get('updated', '')}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("summary", help="List local StackScript directories")

    up_parser = sub.add_parser("update", help="Update StackScript(s) via linode-cli")
    up_parser.add_argument("ids", nargs="*", help="StackScript ID(s) to update (default: all)")
    up_parser.add_argument("-m", "--rev-note", default="Updated via update-stackscripts", help="Revision note")

    args = parser.parse_args()
    if args.command == "update":
        cmd_update(args)
    else:
        cmd_summary(args)


if __name__ == "__main__":
    main()
